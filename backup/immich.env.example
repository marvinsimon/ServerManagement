# Copy to /etc/borg-backup/immich.env on the server and restrict access to it.
# Values use systemd EnvironmentFile syntax; do not use shell substitutions.
BORG_REPO="ssh://USER@HOST:23/./Backup"
BORG_RSH="ssh -i /home/USER/.ssh/KEY_FILE -o BatchMode=yes"
BACKUP_WORKING_DIR="/home/USER"
BACKUP_SOURCE="./ServerManagement/immich/library"
BACKUP_ARCHIVE_PREFIX="immich"
# Borg shell-style pattern. Verify it against your own source directory.
BACKUP_EXCLUDE="*/library/thumbs"
# Seconds to wait for another job to release the Borg repository lock.
BACKUP_LOCK_WAIT=3600
