# Copy to /etc/borg-backup/paperless.env and replace the placeholders.
# This backs up files only, not the Paperless database.
BORG_REPO="ssh://USER@HOST:23/./Backup"
BORG_RSH="ssh -i /home/USER/.ssh/KEY_FILE -o BatchMode=yes"
BACKUP_WORKING_DIR="/home/USER"
BACKUP_SOURCE="./ServerManagement/paperless/data"
BACKUP_SOURCE_2="./ServerManagement/paperless/media"
BACKUP_ARCHIVE_PREFIX="paperless"
BACKUP_LOCK_WAIT=3600
