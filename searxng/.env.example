# Read the documentation before using the `docker-compose.yml` file:
# https://docs.searxng.org/admin/installation-docker.html
#
# Additional ENVs:
# https://docs.searxng.org/admin/settings/settings_general.html#settings-general
# https://docs.searxng.org/admin/settings/settings_server.html#settings-server

# Copy this file to searxng/.env and replace both placeholder values.
# The hostname must match the Traefik router in docker-compose.yml.
SEARXNG_BASE_URL=https://searxng.domain.here/
SEARXNG_SECRET=replace-with-a-long-random-secret
